 "differences": [
  {
   "id": "d-01",
   "topic": "madeira-warnings",
   "kind": "different statement",
   "claims": [
    "w-pt-16",
    "w-en-13"
   ],
   "what": "Madeira's north coast: Portuguese says the red rain warning was extended to the north coast, so the whole island was at red; English still says the north coast was under orange.",
   "reading": "English is the older state: its page was last edited at 20:32 on 10 November. A hypothesis from the edit times, not a finding about IPMA.",
   "label": "hypothesis"
  },
  {
   "id": "d-02",
   "topic": "origin",
   "kind": "different attribution",
   "claims": [
    "w-pt-03",
    "w-en-05"
   ],
   "what": "Who called the low subtropical in origin: Portuguese attributes it to AEMET, Spain's state agency (citing Cadena SER); English attributes it to Meteored, which it calls 'the Spanish weather service' (citing Meteored's own site).",
   "reading": "Two different bodies. AEMET is Spain's state meteorological agency; Meteored is a separate, commercial forecaster. English's label for Meteored is loose.",
   "label": "hypothesis"
  },
  {
   "id": "d-03",
   "topic": "pressure",
   "kind": "different figure",
   "claims": [
    "w-pt-02",
    "w-pt-06",
    "w-zh-01",
    "w-vi-01"
   ],
   "what": "Central pressure: Portuguese gives IPMA's forecast for 00:00 UTC on 11 November, 991 hPa in communiqué no. 1 and 989 hPa in no. 2. Chinese gives a lowest pressure of 994 hPa (995 until 08:28 UTC on 11 November) with no footnote. English leaves the field empty. Vietnamese (from 12:23 UTC on 11 November) gives 999 hPa, also with no footnote.",
   "reading": "Not the same quantity: a forecast for one hour against a 'minimum'. The Chinese figure cannot be checked from the page.",
   "label": "hypothesis"
  },
  {
   "id": "d-04",
   "topic": "extent",
   "kind": "different statement",
   "claims": [
    "w-en-21",
    "w-zh-03"
   ],
   "what": "Areas affected: the English and Chinese infoboxes list Portugal, Spain, France and Italy; the Portuguese infobox lists Madeira and mainland Portugal only.",
   "reading": "France and Italy carry no footnote in either page.",
   "label": "hypothesis"
  },
  {
   "id": "d-05",
   "topic": "naming",
   "kind": "different precision",
   "claims": [
    "w-pt-01",
    "w-en-06"
   ],
   "what": "The naming: Portuguese gives the minute (9 November, 13:17 UTC) and the position; English gives the day.",
   "reading": "They agree; Portuguese is more exact. Both cite IPMA's communiqués index page, an address whose content changes.",
   "label": "evidence"
  },
  {
   "id": "d-06",
   "topic": "alert",
   "kind": "different precision",
   "claims": [
    "w-pt-20",
    "w-en-14"
   ],
   "what": "The alert situation: English gives its hours (00:00 to 23:59 on 11 November) and ANEPC's readiness at the highest level; Portuguese gives neither, but names the minister and lists the measures.",
   "reading": "They agree where they overlap.",
   "label": "evidence"
  },
  {
   "id": "d-07",
   "topic": "red-rain",
   "kind": "same and both behind",
   "claims": [
    "w-pt-18",
    "w-en-11"
   ],
   "what": "Lisbon's red rain warning: both say 12:00 to 18:00.",
   "reading": "Both are behind IPMA, which moved it to 09:00 to 18:00 at 21:23 UTC on 10 November (our row s-1110T2353, from IPMA's CAP message).",
   "label": "fact"
  },
  {
   "id": "d-08",
   "topic": "deaths",
   "kind": "different figure",
   "claims": [
    "w-en-23"
   ],
   "what": "Deaths: English (from 16:40 UTC on 11 November) says 'at least one' in the Canary Islands in its text and 3 in its infobox; Portuguese, Chinese and Vietnamese report none (the Vietnamese infobox: 'no information yet').",
   "reading": "The English infobox and text disagree within one revision; neither figure is from an authority. A hypothesis about the page, not a finding about the storm.",
   "label": "hypothesis"
  }
 ]
