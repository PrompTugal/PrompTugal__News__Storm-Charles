                }
              ],
              "label": "fact",
              "id": "warning:ipma-red-rain-0900",
              "href": "../../data/graph/storm.json"
            }
          ],
          "say": {
            "graph": "IPMA warns this. This precedes that."
          }
        },
        {
          "caption": "Fractal means any node can be opened, and inside it is another graph with its own vocabulary, written by whoever owns that world. Nothing makes the inner world use the outer one's words. Open that again and there is another, down to the smallest thing that still matters to your question.",
          "at": 1,
          "cards": [
