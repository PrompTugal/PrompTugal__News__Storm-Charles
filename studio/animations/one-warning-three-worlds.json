      "scenes": [
        {
          "caption": "A semantic graph is things joined by verbs. This site's graph of the storm has eight types of thing (Actor, Decision, Warning, Signal, Source, Place, Dataset, Agent) and eight verbs (decides, warns, reports, cites, precedes, affects, located-in, produced-by). That is its whole vocabulary: an Actor warns a Warning; a Warning precedes a Decision.",
          "at": 0,
          "cards": [
            {
              "title": "A node in the graph",
              "text": "Red rain warning for the Lisbon district brought forward to 11 Nov 09:00 to 18:00",
              "fields": [
                {
                  "k": "type",
                  "v": "Warning",
                  "new": true
                },
                {
                  "k": "warns",
                  "v": "actor:ipma warns it",
                  "new": true
                },
                {
                  "k": "precedes",
                  "v": "warning:ipma-red-rain precedes it; lead_minutes 293",
                  "new": true
                },
                {
                  "k": "affects",
                  "v": "it affects actor:websummit and actor:government",
                  "new": true
                },
                {
                  "k": "at",
                  "v": "2026-11-10T21:23Z"
                },
                {
                  "k": "level",
                  "v": "red"
                },
                {
