+  # gate says so. SIGN_RELEASE=0 skips it.
+  if [ "${SIGN_RELEASE:-1}" = 1 ] && AGENT="$AGENT" node tools/ci-release-record.mjs --write; then
+    git add data/releases 2>/dev/null && { git diff --cached --quiet || git commit -q --amend --no-edit; }
+  fi
