diff --git a/admin/tools/release.sh b/admin/tools/release.sh
index 1738f9a..d7e633a 100755
--- a/admin/tools/release.sh
+++ b/admin/tools/release.sh
@@ -12,6 +12,11 @@ for attempt in 1 2 3 4 5; do
   git fetch -q origin dev
   git rebase -q origin/dev || { echo "release.sh: conflict with dev; resolve by hand"; git rebase --abort; exit 1; }
   [ "$(git rev-list --count origin/dev..HEAD)" = 0 ] && { echo "release.sh: nothing to push"; exit 0; }
+  # the signed release record (ci/signing.md): this agent's own key signs the digest of the tree it is about to push; the record
+  # rides in its last commit. No key on this machine: the push goes unsigned and the gate says so. SIGN_RELEASE=0 skips it.
+  if [ "${SIGN_RELEASE:-1}" = 1 ] && AGENT="$AGENT" node tools/ci-release-record.mjs --write; then
+    git add data/releases 2>/dev/null && { git diff --cached --quiet || git commit -q --amend --no-edit; }
+  fi
   node admin/build/validate.mjs
   node tools/policy-check.mjs   # each commit's Agent: may change only its own paths (agents/policy.json); a local check, not a boundary
   if git push -q origin HEAD:dev; then echo "pushed $(git rev-parse --short HEAD) by $AGENT; CI numbers, deploys and times it"; exit 0; fi
